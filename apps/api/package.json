{
  "name": "@forge/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "One Cloudflare Worker over D1. No idle state (D-048).",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute forge --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute forge --local --file=./schema.sql",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@forge/engine": "*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260818.1",
    "@types/node": "^22.10.5",
    "wrangler": "^4.123.0"
  }
}
