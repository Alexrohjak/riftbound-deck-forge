# Dependencies
node_modules/
.pnp
.pnp.js
__pycache__/
*.py[cod]
.venv/
venv/

# Build output
dist/
build/
.next/
out/

# Environment & secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key

# Local data
#
# The COLLECTION is personal and must never be committed.
# Public card data from Riot's gallery IS committed — see data/README.md. The upstream
# buildId changes on every site deploy, so a cached snapshot is the mitigation D-034
# already requires, and a complete data layer is what makes good EE answers possible
# (D-039 governs OUTPUT, not storage).
data/collection*
data/decks*
data/*.sqlite
data/*.db
*.sqlite
*.sqlite3
*.db
cache/

# Logs
*.log
npm-debug.log*
yarn-error.log*

# Editors & OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Claude Code local settings
.claude/settings.local.json
